# Local secrets. Copy to .env and fill in; .env never goes to git.
# The first deploy uploads this file: `pnpm wrangler deploy --secrets-file .env`.

# Garmin Connect Personal API key. Create it, signed in on the web, at
# https://connect.garmin.com/app/settings/personalApiToken
# It is shown once, expires (30, 90, 180 or 365 days) and only one can be active.
GARMIN_API_KEY=

# /authorize also needs ONE of these two secrets. They are not set here: add
# the one you chose after the first deploy, with `pnpm wrangler secret put <NAME>`.
#   ACCESS_AUD      Audience (AUD) tag of the Cloudflare Access application
#                   that protects /authorize.
#   OWNER_PASSWORD  A password of at least 16 characters, typed on the consent
#                   page. Used only when ACCESS_AUD is not set.
# `pnpm dev` passes ACCESS_AUD=local-dev itself, matching `access.dev` in
# wrangler.jsonc.
